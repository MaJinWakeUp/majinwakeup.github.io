  booktitle = {2025 IEEE International Conference on Data Mining Workshops (ICDMW)},
  pages     = {96--102},
  year      = {2025},
  doi       = {10.1109/ICDMW69685.2025.00017},
  abstract  = {Medical Large Vision-Language Models (Med-LVLMs) offer substantial potential to advance disease diagnosis by integrating visual medical data with textual clinical knowledge. However, they still face significant challenges with factual hallucination because their knowledge is limited to what was encoded during training. While Retrieval-Augmented Generation (RAG) has emerged as a promising solution, its effectiveness is highly dependent on the quality of retrieved documents, where irrelevant or noisy information can compromise the reliability of generated responses.},
}

